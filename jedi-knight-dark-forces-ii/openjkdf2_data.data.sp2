## 00_AIFramePatrol.cog
## "patroller" travels patrol route of frames. 
## Patrol begins at startup unless either gosector or gosurface are assigned as triggers. 
## Compatible with 00_SendMessage. (Gosurface or gosector must be assigned or it will begin on startup.) 

## Flex Variables:
##
## RouteStyle: use 0 for circular (or 2-point) patrol, 1 for linear, and 2 for random
## FramePause: use a constant value, or use 0 for random pauses between 2 and Maxpause (best for pedestrians)
## NumFrames: number of frames in the route, excluding frame 0; NOTE: Inaccurately high framenum results in 1-way patrol
## PatrolSpeed: 1 for walk (default), 2 for run
## MaxPause: longest pause at frame, used only if framepause = 0

symbols
message	startup
message	activate
message	entered
message	arrived
message	timer

sector	gosector	linkid=1
surface	gosurface	linkid=1

thing		patroller

float		patrolspeed=1.0
float		framepause=1.0
float		routestyle=0.0
float		numframes=1.0
float		maxpause=10.0

int		curframe=1		local
int		framenum=0		local
int		direction=1		local		// control forward or backward through frames
int		begun=0		local
int		testnum=0		local
end

code
startup:
	if (gosector + gosurface == -2)	// no sector/surface assigned
	{
		call beginpatrol;
	}
	return;

activate:
	call beginpatrol;
	return;

entered:
	if (GetSenderID() != 1) return;
	
	call beginpatrol;
	return;
	
beginpatrol:
	if (begun) return;
	begun = 1;
	
	AISetMoveSpeed(patroller, patrolspeed);
	
	SetTimer(.1);
	return;

arrived:
	curframe = curframe + direction;
	if (curframe > numframes)			// end of patrol
	{
		if (routestyle == 1)
		{
			direction = -1;			// if linear, reverse frame directional
			curframe = numframes - 1;
		}
		else
		{
			curframe = 0;			// if circular, go to frame 0
		}
	}

	if ((curframe == -1) && (routestyle == 1))	// if linear and returned to initial frame
	{
		direction = 1;					// restore forward frame directional
		curframe = 0;
	}

	if (routestyle == 2)
	{
		curframe = (Rand() * numframes) + 1;
	}

	if (framepause > 0)
	{
		SetTimer(framepause);
	}
	else
	{
		SetTimer((Rand() * (maxpause - 1)) + 2);
	}
	return;

timer:
	AISetLookFrame(patroller, curframe);
	AISetMoveFrame(patroller, curframe);
	return;
end

# Jedi Knight Cog Script
#
# 00_BLOODTRAIL.COG
#
# Leave a blood trail behind a severed limb
#
# [YB]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved

flags=0x240

symbols

template    blood=+limb_blood                local
int         dummy                            local

message     created
message     pulse
message     timer

end

# ========================================================================================

code
created:
   SetThingPulse(GetSenderRef(), 0.05);            // set 50 msec timer for blood release
   SetTimerEx(1.1, GetSenderRef(), 0, 0);          // cut it after 1.1 seconds
   Return;

# ........................................................................................

pulse:
   dummy = CreateThing(blood, GetSenderRef());     // create blood at our current location

   Return;

# ........................................................................................

timer:
   SetThingPulse(GetSenderId(), 0);

   Return;

end


# Jedi Knight Missions Cog Script
#
# 00_CARBSTATUE.COG
#
# Frozen carbonite statue cog.
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved

flags=0x240

symbols

message	created
message	pulse
message	removed

thing		aThing;

end

code

created:
	SetThingPulse(GetSenderRef(), 0.5);
	return;

pulse:
	if (GetThingUserData(GetSenderRef()) >= 5000)
	{
		aThing = GetThingUserData(GetSenderRef()) - 5000;

      SetThingPosEx(GetSenderRef(), GetThingPos(aThing), GetThingSector(aThing));
	}
	return;

removed:
	SetThingPulse(GetSenderRef(), 0.0);
	return;

end

# Jedi Knight Cog Script
#
# 00_Debris.cog
#
# [SRS]
#
# (C) 1998 LucasArts Entertainment Co. All Rights Reserved


symbols

message     user0

template dust=+sparks         local

# these must be in order!
template debTmpl=GrShrapnel_1  local
template debTmpl1=GrShrapnel_2 local
template debTmpl2=GrShrapnel_3 local
template debTmpl3=GrShrapnel_4 local
template debTmpl4=GrShrapnel_5 local

# these must be in order!
thing    debPoint           nolink
thing    debPoint1          nolink
thing    debPoint2          nolink
thing    debPoint3          nolink
thing    debPoint4          nolink
thing    debPoint5          nolink
thing    debPoint6          nolink
thing    debPoint7          nolink
thing    debPoint8          nolink

int      numPoints      nolink


int      minDeb         nolink
int      maxDeb         nolink
#a 1-10 percent chance (valid #'s 1-10)
#higher number, less chance
int      chanceDeb      nolink


int		cnt=0		      local
thing    debTemp        local
int		temp			   local

vector	angOffset		local

end

# ========================================================================================
code

user0:
   // ("deb create recieved");
   for ((cnt = 0); (cnt < numPoints); (cnt=cnt+1))
   {
		if (VectorDist(GetThingPos(GetLocalPlayerThing()), GetThingPos(debPoint[cnt])) < 3.0)
      if (debPoint[cnt] != -1)
      {
         CreateThing (dust, debPoint[cnt]);
         if ((Rand () * 10) > chanceDeb)
         {
            temp = minDeb + (Rand () * (maxDeb - minDeb));
            //int (temp);

            for (temp; (temp > 0); (temp = temp -1))
            {
               debTemp = CreateThing (debTmpl[(Rand () * 4)], debPoint[cnt]);
               angOffset = VectorSet ((Rand() * 0.01) - 0.005, ((Rand() * 0.01) - 0.005), ((Rand() * 0.02) - 0.01));
               ApplyForce (debTemp, angOffset);
            }
         }
      }
   }
   return;

end
# Jedi Knight Cog Script
#
# 00_Desaster.cog
#
# [SRS]
#
# (C) 1998 LucasArts Entertainment Co. All Rights Reserved


symbols

message		startup
message     timer
message     pulse

# these must be in order!
cog    debGen           nolink
cog    debGen1          nolink
cog    debGen2          nolink
cog    debGen3          nolink
cog    debGen4          nolink
cog    debGen5          nolink
cog    debGen6          nolink
cog    debGen7          nolink
cog    debGen8          nolink

#number of generators
int   numGens           nolink

int      minFreq        nolink
int      maxFreq        nolink

sound		hitSnd         nolink

flex		min_volume     nolink
flex		range_volume   nolink

int		temp			   local
int		cnt=0		      local
	
vector	posOffset		local
vector	angOffset		local
thing    debTemp        local

int         player               	local

end

# ========================================================================================
code
startup:
   SetTimerEx (minFreq + (Rand () * maxFreq), 0, 0, 0);
	return; 

# ========================================================================================
timer:
   if (hitSnd != -1)
   {
      PlaySoundLocal (hitSnd, (min_volume + (rand() * range_volume)), ((rand() * 2) - 1.0), 0);
   }
	SetPOVShake('0.0 -.01 0.0', '1.0 0.0 0.0', .5, 80.0);
	SetPulse(0.1);

   for ((cnt = 0); (cnt < numGens); (cnt=cnt+1))
   {
      if (debGen[cnt] != -1)
      {
         // ("trigger debris");
         SendMessage (debGen[cnt], user0);
      }
   }
   cnt = 0;
   return;

pulse:
	if (cnt < 8) {
		cnt = cnt+1;
		posOffset = VectorSet(Rand() * 0.01, Rand() * 0.01, Rand() * 0.01);
		angOffset = VectorSet(Rand(), Rand(), Rand());
		SetPOVShake (posOffset, angOffset, .5, 80.0);
	}
	else if (cnt == 8) {
		SetPulse (0);
		cnt=0;
      SetTimerEx (minFreq + (Rand () * maxFreq), 0, 0, 0);
	}
   return;


end

