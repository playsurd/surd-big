# Jedi Knight Cog Script
#
# ITEM_FIELDLIGHT.COG
#
# INVENTORY Script - Field Light
#
# [CYW & YB]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved


symbols

thing       player
int         actorFlags

message     activated
message     pulse
message     killed

sound       lightActivate=activate04.wav
sound       lightDeactivate=deactivate04.wav

end

# ========================================================================================

code

activated:
   player = GetSourceRef();

   actorFlags = GetActorFlags(player);

   if(GetInv(player, 42))
   {
      if(BitTest(actorFlags, 4))
      {
         // Print("Field Light OFF");
         jkPrintUNIString(player, 252);
         ClearActorFlags(player, 4);
         SetInvActivated(player, 42, 0);
         PlaySoundThing(lightDeactivate, player, 1.0, -1, -1, 0x80);
         SetPulse(0);
      }
      else
      {
         if(GetInv(player, 13) > 0)
         {
            // Print("Field Light ON");
            jkPrintUNIString(player, 251);
            SetActorFlags(player,4);
            SetInvActivated(player, 42, 1);
            PlaySoundThing(lightActivate, player, 1.0, -1, -1, 0x80);
            SetPulse(1.5);
         }
         else
         {
            // Print("Field Light out of power");
            PlaySoundThing(lightDeactivate, player, 1.0, -1, -1, 0x80);
            jkPrintUNIString(player, 253);
         }
      }
   }

   Return;

# ........................................................................................

pulse:
   ChangeInv(player, 13, -1);
   if(GetInv(player, 13) == 0)
   {
      // Print("Field Light out of power");
      jkPrintUNIString(player, 253);
      PlaySoundThing(lightDeactivate, player, 1.0, -1, -1, 0x80);
      ClearActorFlags(player, 4);
      SetInvActivated(player, 42, 0);
      SetPulse(0);
   }

   Return;

# ........................................................................................

killed:
   player = GetLocalPlayerThing();
   if(GetSenderRef() != player) Return;

   if(IsInvActivated(player, 42) == 1)
   {
      SetPulse(0);
      ClearActorFlags(player, 4);
      SetInvActivated(player, 42, 0);
   }
   Return;

end




# Jedi Knight Missions Cog Script
#
# ITEM_HEAVY_EXPLOSIVE.COG
#
# INVENTORY script - Heavy Explosive
# Bin 53
#
# [YB] + [RF] + [TNT]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved


symbols

message     activated
message	user0
message	user1

sound       keysound=BactaUse01.WAV

thing       player			local

template	explosive_tpl=EC.3do	local

int		ready=0			local
int		explosive			local

cog		endlevel			local

end


code

activated:
	endlevel=GetMasterCog();
	// Print("Invcog sending user1 message to endlevel.  Activated.");
	SendMessage(endlevel, user1);
	Return;

user1:
		If(ready) return;
		ready=1;
		player=GetLocalPlayerThing();
		// Print("Invcog received message from endlevel.");
		// Print("Invcog says: Player is on dome!");
		jkPrintUNIString(player, 273);		// "Heavy Explosive"
		PlaySoundLocal(keysound, 1.0, 0.0, 0);
		PlayMode(player, 16);
		Sleep(1.0);
		SendMessage(endlevel, user2);
		// Print("invcog sending user2 message to endlevel");
	Return;


end




