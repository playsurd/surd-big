	"PRESS_ACTIVATE_TO_RESTORE"	0	"Press FIRE to restore last saved position"
   "PRESS_ACTIVATE_TO_RESTART"   0  "Press FIRE to restart this level."
	"PRESS_ACTIVATE_TO_RESPAWN"	0 	"Press FIRE to return to the game"

