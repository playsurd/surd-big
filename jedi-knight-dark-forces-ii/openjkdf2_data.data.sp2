rail_detonator          127             0       1       0x0a4   cog=weap_raildet_m.cog
sequencer_charge        128             0       30      0x0a4   cog=weap_seqcharge_m.cog
concussion_rifle        129             0       1       0x0a4   cog=weap_concrifle_m.cog
EWEB                    130             0       32000   0x0b4   cog=weap_EWEB_m.cog

lightsaber              131             0       1       0x0a4   cog=weap_saber_m.cog
blastech                132             0       1       0x0a4   cog=weap_blastech_m.cog
stormtrooper_scope      133             0       1       0x0a4   cog=weap_stscope_m.cog
flash_bomb              134             0       30      0x0a4   cog=weap_flash_m.cog
tusken_prod             135             0       1       0x0a4   cog=weap_crossbow_m.cog
