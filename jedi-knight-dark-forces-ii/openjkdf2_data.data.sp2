param 33: 1.0     # modifier to deadly sight damage
param 34: 1.0     # modifier to carbon freeze duration

param 38: 11      # non pullable weapon number 1
param 39: 11      # non pullable weapon number 2

# parameters 100+ are non-cog controlled parameters
param 100: 0      # 0 defense stars


