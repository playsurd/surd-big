   "%s_IS_%s"							0	"%s is %s"

	"FLYING_ON"							0	"Fly mode on"
	"FLYING_OFF"						0	"Fly mode off"

	"RECORDING_OPENED"				0	"Recording opened"
	"RECORDING_CLOSED"				0	"Recording closed"

