new_stars               16              0       32      0x000

#spendable stars
spend_stars             17              0       32      0x000

#total number of stars.
total_stars             18              0       32      0x000


###############
#Force Defense#
###############

f_defense               19              0      4.0      0x018     cog=force_defense.cog


##############
#Force Powers#
##############

