# Item definition file for Jedi Knight Missions

####################################################
#                                                  #
# Note that things aren't always in numeric order, #
# so be careful when making new assignments - rf   #
#                                                  #
####################################################

# ========================================================================================
# name                  id              min     max     flags   args
# ========================================================================================

###########
# Weapons #
###########

# ========================================================================================
none                    120             0       0       0x004

fists                   121             0       1       0x024   cog=weap_fists_m.cog
