# Jedi Knight Cog Script
#
# POW_DARKSIDE.COG
#
# POWERUP Script - Dark Surge
#
# [YB & CYW]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved


symbols

thing       powerup                          local
thing       player                           local
int         bin=14                           local
sound       pickupsnd=helthpu1.wav           local
sound       outsnd=SCAlarm.wav               local
sound       respawnsnd=Activate01.wav        local

message     startup
message     shutdown
message     touched
message     taken
message     timer
message     newplayer
message     respawn
message     pulse

end

# ========================================================================================

code

startup:
shutdown:
   player = GetLocalPlayerThing();
   call stop_power;
   Return;

# ........................................................................................

touched:
   TakeItem(GetSenderRef(), -1);
   call taken;

   Return;

# ........................................................................................

taken:
   player = GetSourceRef();
   powerup = GetSenderRef();

   // Print("Dark Surge");
   jkPrintUNIString(player, 64);

   // Do effects.
   PlaySoundLocal(pickupsnd, 1, 0, 0);
   AddDynamicTint(player, 0.0, 0.0, 0.2);

   // Effect lasts 20 seconds, expand if already on.
   KillTimerEx(1);

   // Stop the surge effect after 20 seconds
   SetTimerEx(20, 1, player, 1);

   SetTimerEx(20 - 3 * GetSoundLen(outsnd) - 0.55, 1, player, 0);

   // Stop flashing and make a check to see if we retook
   // another surge while this one was finishing...
   SetTimerEx(20.5, 1, player, 3);

   SetPulse(0);

   // Set mana amount to max.
   SetInv(player, bin, GetInv(player, 20) * 50);

   // Make the surge active
   SetInv(player, 64, 1);

   // Do the visual effects
   jkSetSuperFlags(4);

   Return;

# ........................................................................................

timer:
   if(GetParam(1) == 0)
   {
      // Power will end soon...
      SetPulse(0.33);

      PlaySoundLocal(outsnd, 1.0, 0.0, 0);

      SetTimerEx(GetSoundLen(outsnd) + 0.25, 1, player, 2);
      SetTimerEx(2*(GetSoundLen(outsnd) + 0.25), 1, player, 2);
   }
   else
   if(GetParam(1) == 1)
   {
      call stop_power;
   }
   else
   if(GetParam(1) == 2)
   {
      PlaySoundLocal(outsnd, 1.0, 0.0, 0);
   }
   else
   if(GetParam(1) == 3)
   {
      SetPulse(0);

      if(GetInv(player, 64) == 1.0)
         jkSetSuperFlags(4);
      else
         jkClearSuperFlags(4);
   }

   Return;

# ........................................................................................

pulse:
   if(jkGetSuperFlags() & 4)
      jkClearSuperFlags(4);
   else
      jkSetSuperFlags(4);

   Return;

# ........................................................................................

newplayer:
   call stop_power;
   Return;

# ........................................................................................

respawn:
   PlaySoundThingLocal(respawnsnd, GetSenderRef(), 0.6, 5.0, 10.0, 0);

   Return;

# ........................................................................................

stop_power:
   SetPulse(0);
   KillTimerEx(1);
   SetInv(player, 64, 0);
   jkClearSuperFlags(4);
   Return;

end

# Jedi Knight Missions Cog Script
