# Jedi Knight Cog Script
#
# 00_ThrownSaber.COG
#
# This is the class cog of the object that is created
# at the instant of the explosion on the wall.
# This object will only live for a frame, but it will
# create the real saber if it is running on the server.
# Sadly, this will be lag dependent, but since the object
# created is a powerup the server should create it...
#
# [YB]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved

flags=0x40

symbols

int         parent                           local
int         saberDummy                       local
int         saber                            local

template    saber_tpl=+fSaberReturns         local

message     created
message     timer

end

# ========================================================================================

code

created:
   saberDummy  = GetSenderRef();
   parent      = GetThingParent(saberDummy);

   if(!IsMulti() || IsServer())
   {
      // we cannot use CreateThing because the explosion thing
      // is already dead when the message arrives in multi...

      saber = CreateThingAtPos(saber_tpl,
                               GetThingSector(saberDummy),
                               GetThingPos(saberDummy),
                               '0 0 0');

      SetThingUserData(saber, parent);

      SetTimerEx(0.1, 1 , 0, 0);
      SetTimerEx(1.5, 2 , 0, 0);
   }

   DestroyThing(saberDummy);

   Return;

# ........................................................................................

timer:

   if(GetSenderId() == 1)
   {
      // Returning the saber now...

      // Much faster if both the parent and the saber is in the water
      if((GetSectorFlags(GetThingSector(parent)) & 2) && (GetSectorFlags(GetThingSector(saber)) & 2))
         SetThingVel(saber, VectorScale(VectorNorm(VectorSub(GetThingPos(parent), GetThingPos(saber))), 15));
      else
      // Faster if only one of the parent or the saber is in the water
      if((GetSectorFlags(GetThingSector(parent)) & 2) || (GetSectorFlags(GetThingSector(saber)) & 2))
         SetThingVel(saber, VectorScale(VectorNorm(VectorSub(GetThingPos(parent), GetThingPos(saber))), 9));
      // Normal speed of return if both are out of the water
      else
         SetThingVel(saber, VectorScale(VectorNorm(VectorSub(GetThingPos(parent), GetThingPos(saber))), 3));
   }
   else
   if(GetSenderId() == 2)
   {
      // Add Gravity in case it was missed by the player
      SetPhysicsFlags(saber, 0x1);
      SyncThingPos(saber);
   }

   Return;

end

# Jedi Knight Cog Script
#
# 00M_Transport_TakeOff.cog
#
# Generates up to 6 characters before transport takes off.  Must use all 7 
# Transport frames for this cog to work.
#
# [JK]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
# ========================================================================================

symbols

message		entered
sector		startsector

int		done=0				local

sound           liftsound
thing           lifter			

thing		pos0	 			desc=generator_ghost
thing		target0
thing		pos1				desc=generator_ghost
thing		target1
thing		pos2				desc=generator_ghost
thing		target2			
thing		pos3	 			desc=generator_ghost
thing		target3

template	enemy_tpl0			desc=enemy_to_generate
template	enemy_tpl1			desc=enemy_to_generate
template 	enemy_tpl2			desc=enemy_to_generate
template	enemy_tpl3			desc=enemy_to_generate

int		enemy0			local
int		enemy1			local
int		enemy2			local
int		enemy3			local

keyframe	lift

end

# ========================================================================================

code
entered:
	if (done) return;
	done=1;

	enemy0=CreateThing(enemy_tpl0, pos0);
	CaptureThing(enemy0);
	AISetLookPos(enemy0, GetThingPos(target0));
	AISetMoveSpeed(enemy0, 2.0);
	AISetMovePos(enemy0, GetThingPos(target0));

	enemy1=CreateThing(enemy_tpl1, pos1);
	CaptureThing(enemy1);
	AISetLookPos(enemy1, GetThingPos(target1));
	AISetMoveSpeed(enemy1, 2.0);
	AISetMovePos(enemy1, GetThingPos(target1));

	enemy2=CreateThing(enemy_tpl1, pos2);
	CaptureThing(enemy2);
	AISetLookPos(enemy2, GetThingPos(target2));
	AISetMoveSpeed(enemy2, 2.0);
	AISetMovePos(enemy2, GetThingPos(target2));
	
	enemy3=CreateThing(enemy_tpl3, pos3);
	CaptureThing(enemy3);
	AISetLookPos(enemy3, GetThingPos(target3));
	AISetMoveSpeed(enemy3, 2.0);
	AISetMovePos(enemy3, GetThingPos(target3));

	Sleep(0.4);

	PlayKey(lifter, lift, 1, 0x4);
	PlaySoundThing(liftsound, lifter, 1.0, -1, 225, 128); 
	Sleep(GetKeyLen(lift));
	DestroyThing(lifter);

	Return;

end
    # Jedi Knight Cog Script
#
# S1L1_STORMGEN.COG
#
# Generic Dark Forces like enemy generator.
# 8/22/97 Modified for sector activation.
# 8/22/97 Modified for move to frame.
#
# [KS]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved


symbols

thing       pos0                             desc=generator_ghost
thing       target0
template    enemy_tpl                        desc=enemy_to_generate
flex        initial_delay=300.0              desc=initial_delay
flex        generate_delay=30.0              desc=generate_delay
flex        generate_num=5                   desc=generate_number
flex        max_alive=3                      desc=max_alive
flex        min_dist=0.0                     desc=min_dist
flex        max_dist=1000.0                  desc=max_dist
int         max_gen=4
sector      startsector
flex        done=0                           local

thing       enemy0                           local
flex        cur_num=0                        local
flex        cur_alive=0                      local
flex        distance=0.0                     local
int         player                           local 

message     entered
message     user0
message     timer
message     pulse
message     killed   

end

# ========================================================================================

code

entered:
   if(done) return;
   done = 1;

   enemy0 = CreateThing(enemy_tpl, pos0);
   CaptureThing(enemy0);
   AISetMoveThing(enemy0, target0);

   SetPulse(generate_delay);

   Return;

# ........................................................................................

pulse:
   if (!max_gen) return;
   max_gen = max_gen - 1;

   if(cur_alive < max_alive)
   {
      player=GetLocalPlayerThing();
      distance = VectorDist(GetThingPos(pos0), GetThingPos(player));
      if((distance >= min_dist) && (distance <= max_dist))
      {
         player=GetLocalPlayerThing();
         if(!HasLOS(player, pos0))
         {
            enemy0 = CreateThing(enemy_tpl, pos0);
            captureThing(enemy0);
      
            cur_num   = cur_num + 1;
            cur_alive = cur_alive + 1;
            // If we have generated enough enemies, end the pulse
            if(cur_num >= generate_num) SetPulse(0);
         }
      }
   }

   CaptureThing(enemy0);
   AISetMoveThing(enemy0, target0);

   Return;

# ........................................................................................

killed:
   cur_alive = cur_alive - 1;

   Return;

end


# Jedi Knight Cog Script
#
# ACTOR_ATST.COG
#
#
# Actor COG for Standard ATST
# Possibly creates ATAT driver upon death
# Resitances to certain types of damage
#
# [CR]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
#
# ========================================================================================

symbols

message         killed
message         skill
message         damaged

template        pilot=ATATpilot		local
template        pilot2=ATATpilot     	local
template        explosion=+atst_exp     local
thing           newThing                local
flex            rval                    local
flex            damageType              local
flex            damageAmount            local
flex            totalDamage             local
int             player                  local

end

# ========================================================================================

code

killed:
   rval = Rand();
   if (rval < 0.45)
   {
      newThing = CreateThing(explosion, GetSenderRef());
      newThing = CreateThing(pilot, GetSenderRef());
   }
   else if (rval < 0.60)
   {
      newThing = CreateThing(explosion, GetSenderRef());
      newThing = CreateThing(pilot2, GetSenderRef());
   }
   else
   {
      newThing = CreateThing(explosion, GetSenderRef());
      newThing = CreateThing(pilot, GetSenderRef());
      DamageThing(newThing, 1000.0, 0x2, -1);
   }
   return;

# ........................................................................................

skill:
   ReturnEx(-1);
   return;

# ........................................................................................

damaged:
   damageAmount = GetParam(0);
   damageType = GetParam(1);

   totalDamage = damageAmount;

   if(BitTest(damageType, 0x01))
      totalDamage = damageAmount * 0.0;
   else if(BitTest(damageType, 0x02))
      totalDamage = damageAmount * 0.25;
   else if(BitTest(damageType, 0x10))
      totalDamage = damageAmount * 0.5;

   player = GetLocalPlayerThing();

   if(GetThingParent(GetSourceRef()) == player)
   {
      if(GetCurWeapon(player) == 1)
      {
         if(GetThingHealth(player) > 1)
         {
            DamageThing(player, 1, 0x1, player);
         }
      }
   }

   ReturnEx(totalDamage);

   return;

end

# Jedi Knight Cog Script
#
# ACTOR_CS.COG
#
# This cog causes attached crate to explode if damaged sufficiently
# Possibly creates a powerup
# Used for small size crates
# Actually a class COG
#
# 7/8  - CR  - Finally finished
# 7/16 - CR  - Reduced health
#
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
#
# ========================================================================================

symbols

message	        created
message          damaged

template			crate_exp=+scrate_exp			local
int				crate			      				local
flex				cratehealth  						local
flex				damage								local
template	      powerup1=+DBactaTank	         local
template       powerup3=+DBattery            local
template       powerup4=+DEnergyCell         local
template       powerup5=+DPowerCell          local
thing		      newThing		                  local
flex           rval                          local

end

# ========================================================================================
code

created:
	SetThingUserData(GetSenderRef(), 25);		   // set the initial user data (i.e. "health")
	return;

# ............................................................................................

damaged:
   crate = GetSenderRef();
   damage = GetParam(0);
   cratehealth = GetThingUserData(crate);

	if(GetParam(1) == 1) Return;					   // crate won't be damaged by damage type impact

   if(cratehealth <= damage)				         // is this enough damage to kill the crate ?
	{
		CreateThing(crate_exp, GetSenderRef());	   // create an explosion
    	rval = Rand();
	   if (rval < 0.01)
	   {
		   newThing = CreateThing(powerup1, GetSenderRef());
		   SetLifeleft(newThing, 200.0);
      }
	   else if (rval < 0.26)
	   {
		   newThing = CreateThing(powerup3, GetSenderRef());
		   SetLifeleft(newThing, 200.0);
      }
      else if (rval < 0.51)
      {
         newThing = CreateThing(powerup4, GetSenderRef());
		   SetLifeleft(newThing, 200.0);
      }
      else if (rval < 0.67)
      {
         newThing = CreateThing(powerup5, GetSenderRef());
		   SetLifeleft(newThing, 200.0);
      }
      DestroyThing(GetSenderRef());					// Destroy the crate
      return;
   }

	SetThingUserData(crate, cratehealth - damage);
	return;

end




# Jedi Knight MOTHS Cog Script
#
# ACTOR_I2.COG
#
#
# Actor COG for Commandos with Repeaters
# Punch when their weapons get pulled
# Creates powerup upon death
#
# 7/28/97 [CR] Doubled saber damage for single player gameplay reasons
#
# [SRS]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
#
# ========================================================================================

symbols

message          killed
message          skill
message          damaged

template         powerup=+DRepeaterGun   local
thing            newThing                local
int              bin                     local
int              senderref=-1            local
ai               flee_ai=noweapon.ai     local
ai               punch_ai=st_punch.ai    local
int              damage                  local

vector		currentpos								local

end

# ========================================================================================

code

damaged:
   damage = GetParam(0);
   if(GetParam(1) == 16)
   {
      damage = (damage * 2.0);
   }
   ReturnEx(damage);
   return;

# ........................................................................................

killed:
   victim = GetSenderRef();
   // If he hasn't lost his weapon already somehow.
   if (GetActorWeapon(victim, 1) != -1)
   {
      AmputateJoint(victim, 3);
      newThing = CreateThing(powerup, victim);
      SetLifeleft(newThing, 200.0);
   }
   return;

# ........................................................................................

skill:
   bin = GetParam(0);
   if (bin == 24)       // Force Pull
   {
      // he's a fighter, not a fleer... -srs

      senderref = GetSenderRef();
			// If he hasn't been pulled yet...
		if (GetActorWeapon (senderref, 1) != -1)
		{
			SetActorWeapon(senderref, 1, -1);

			newThing = CreateThing(powerup, GetSenderRef());
			SetLifeleft(newThing, 30.0);

			AISetClass (senderref, punch_ai);
			AISetMode(senderref, 0x4);

			ReturnEx(newThing);
		}
		else
		{
				// Give the actor a shove towards the player.
			currentpos = VectorSub(GetThingPos(GetLocalPlayerThing(), senderref));
			currentpos = VectorScale(VectorNorm(currentPos), 250);
			ApplyForce(senderref, currentpos);

			ReturnEx(-1);
		}

      //AIFlee(senderref, GetLocalPlayerThing());

      Return;
   }
   else
   if (bin == 31)       // Force Grip
   {
      ReturnEx(10);     // return base damage that is taken by this actor.
      return;
   }
   else
   if (bin == 34)       // Deadly Sight
   {
      ReturnEx(5);      // return base damage that is taken by this actor.
      return;
   }
   ReturnEx(-1);
   return;

end

# Jedi Knight Cog Script
#
# ACTOR_R5.COG
#
# ACTOR Script - Standard R5
#
# [CR]
#
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
#
# ========================================================================================

symbols

message		killed
message	   skill
message	   damaged
message     touched
message     timer
message     created

template		powerup=+DPowerCell	      local
template		powerup1=+DShield 	      local
template		explosion=+r2r5_exp	      local
thing			newThing		               local
flex			damage			            local
flex			damageType		            local
flex			totalDamage		            local
flex			rval                       local
int         me                         local
int         toucher                    local
int         count                      local
int         player                     local
int			id									local
thing       killer                     local
sound       two=R2Talk02.wav
int         sound                      local



end

# ========================================================================================

code

created:
	SetTimerEx(1.0, 1, 0.0, 0.0);
	return;

# ........................................................................................

killed:
	player = GetLocalPlayerThing();
	killer = GetSourceRef();

	// Player killed a droid.
	if (player == killer)
   {
      ChangeInv( player, 72, 0.5 );
   }

	
   rval = Rand();
	if (rval < 0.2)
	{
		newThing = CreateThing(powerup1, GetSenderRef());
		SetLifeleft(newThing, 200.0);
	}
	else if (rval < 0.3)
	{
		newThing = CreateThing(powerup, GetSenderRef());
		SetLifeleft(newThing, 200.0);	
	}
   else if (rval < 0.5)
	{
		newThing = CreateThing(explosion, GetSenderRef());
	}
	return;

# ........................................................................................

skill:
	ReturnEx(-1);
	return;

# ........................................................................................

damaged:
	StopSound(sound, 0);
   damage = GetParam(0);
	damageType = GetParam(1);

	if (BitTest(damageType, 0x01))
		damage = 1.0;

        player = GetLocalPlayerThing();

        if(GetThingParent(GetSourceRef()) == player)
        {
         if (GetCurWeapon(player) == 1)
         {
          if (GetThingHealth(player) > 1)
          {
           DamageThing(player, 1, 0x1, player);
          }
         }
        }

   ReturnEx(damage);
   return;

touched:
   me = GetSenderRef();
	toucher = GetSourceRef();
	player = GetLocalPlayerThing();

	if (player != toucher) return;

   if (count == 1) return;
  	
   sound = PlaySoundThing(two, me, 1, -1, -1, 0x10080);
   SetTimerEx(2.0, 0, 0, 0);

   count = 1;

   return;

# ........................................................................................

timer:
	id = GetSenderId();
	if (id == 0)
	{
		count = 0;
	}
	else
	if (id == 1)
	{
		player = GetLocalPlayerThing();
		ChangeInv( player, 73, 0.5 );
	}
   return;



end


# Jedi Knight Cog Script
#
# ACTOR_RC.COG
#
#
# Actor COG for Rebel Commandos with Rifles
#
#
# [SRS]
#
# (C) 1997 LucasArts Entertainment Co. All Rights Reserved
#
# ========================================================================================

symbols

message          skill
message          damaged
#message          pulse
message          created
message          killed

template         powerup=+Dstrifle       local
thing            newThing                local
thing            victim                  local
thing	           me                      local
thing            target                  local
thing            player           nolink local
thing       killer                  local
int              damage                  local
int              bin                     local
int              senderref=-1            local
ai               flee_ai=noweapon.ai     local

vector		currentpos								local

sound    manaSnd=ForceFieldHit01.WAV local

end

# ========================================================================================
code
created:
//	SetThingPulse (GetSenderRef (), 1 + 3 * Rand ());
	return;

# ........................................................................................

killed:
   player = GetLocalPlayerThing();
   killer = GetSourceRef();
   victim = GetSenderRef();

   // Player killed a pedestrian.
   if (player == killer)
   {
      PlaySoundLocal(manaSnd, 1, 0, 4);
      ChangeInv( player, 72, 1.0 );
      SetInv(player, 14, 0);
   }

   if(GetActorWeapon(victim, 1) != -1)
   {
      AmputateJoint(victim, 3);

      newThing = CreateThing(powerup, victim);
      SetLifeleft(newThing, 200.0);
   }

   return;

# ........................................................................................

//pulse:
//	// see if we've lost our interest
//	me = GetSenderRef ();
//	if (AIGetInterest (me) != -1)
//		return;
//
//	// search for bad guys
//	player = GetLocalPlayerThing ();
//	target = FirstThingInView (me, 300, 100.0, 0x404);
//	while (target != -1)
//	{
//		// if it's a bad guy...
//		if (target != player && AIGetAlignment (target) < 0.0)
//		{
////			Print ("Acquired target");
//
//			// turn off sleep and user control
//			AIClearMode (me, 0x3844);
//
//			// set the move & fire targets to valid, and enable move/turn/attack
//			AISetMode (me, 0x063b);
//			
//			// set our interest and fire target
//			AISetInterest (me, target);
//			AISetFireTarget (me, target);
//			AISetMoveTarget (me, target);
//			AISetLookPos (me, GetThingPos (target));
//			return;
//		}
//		target = NextThingInView ();
//	}
//
//	// nothing to shoot at, put ourself to sleep
//	AISetMode (me, 0x3000);
//	
//	return;
	
# ........................................................................................
damaged:
   damage = GetParam (0);
   me = GetSenderRef ();

   // Percent chance change targets...
	if (AIGetInterest (me) != -1)
   {
      // the more damage, the more the chance I'll target them
      bin = Rand() * (75 + damage);
   }
   else
   {
      bin = 100;
   }

   if (bin >= 50)
   {
      target = GetThingParent (GetSourceRef ());

      if (AIGetAlignment (target) < 0.0)
      {
         if (target != GetLocalPlayerThing ())
         {
   			// turn off sleep and user control
   			AIClearMode (me, 0x3844);
   			// set the move & fire targets to valid, and enable move/turn/attack
   			AISetMode (me, 0x063b);

   			// set our interest and fire target
   			AISetInterest (me, target);
   			AISetFireTarget (me, target);
   			AISetMoveTarget (me, target);
   			AISetLookPos (me, GetThingPos (target));
         }
      }
   }

   ReturnEx (damage);
   return;

# ........................................................................................
skill:
   bin = GetParam(0);
   if (bin == 24)       // Force Pull
   {
      // he's a fighter, not a fleer... -srs

      senderref = GetSenderRef();
			// If he hasn't been pulled yet...
		if (GetActorWeapon (senderref, 1) != -1)
		{
			SetActorWeapon(senderref, 1, -1);

			newThing = CreateThing(powerup, GetSenderRef());
			SetLifeleft(newThing, 30.0);

			AISetClass (senderref, flee_ai);
			AISetMode(senderref, 0x4);

			ReturnEx(newThing);
		}
		else
		{
				// Give the actor a shove towards the player.
			currentpos = VectorSub(GetThingPos(GetLocalPlayerThing(), senderref));
			currentpos = VectorScale(VectorNorm(currentPos), 250);
			ApplyForce(senderref, currentpos);

			ReturnEx(-1);
		}

      //AIFlee(senderref, GetLocalPlayerThing());

      Return;
   }
   else
   if (bin == 31)       // Force Grip
   {
      ReturnEx(10);     // return base damage that is taken by this actor.
      return;
   }
   else
   if (bin == 34)       // Deadly Sight
   {
      ReturnEx(5);      // return base damage that is taken by this actor.
      return;
   }

   ReturnEx(-1);
   return;
end

