    u_xlat9.xyw = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.w)].value[(48 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.w)].value[(48 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat2.w)].value[(48 >> 2) + 2]));
