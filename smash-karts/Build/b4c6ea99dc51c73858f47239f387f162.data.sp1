    u_xlat5.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.x)].value[(0 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.x)].value[(0 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.x)].value[(0 >> 2) + 2]));
