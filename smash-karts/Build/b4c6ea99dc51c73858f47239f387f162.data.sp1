uint u_xlatu0;
bool u_xlatb0;
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
void main()
{
    u_xlatu0 = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x;
    u_xlatb0 = u_xlatu0<numReplacements;
