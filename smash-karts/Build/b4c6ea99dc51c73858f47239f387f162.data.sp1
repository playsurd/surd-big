    u_xlat9.xyz = vec3(uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.z)].value[(16 >> 2) + 0]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.z)].value[(16 >> 2) + 1]), uintBitsToFloat(inMatrices_buf[floatBitsToInt(u_xlat4.z)].value[(16 >> 2) + 2]));
