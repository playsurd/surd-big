    u_xlat6.z = dot(u_xlat2, u_xlat3);
    u_xlat1.w = u_xlat0.w;
    u_xlat6.w = dot(u_xlat4.yzx, u_xlat1.xyw);
    u_xlat0.x = dot(u_xlat5.yzx, u_xlat1.xyw);
    u_xlat0.y = dot(u_xlat2.yzx, u_xlat1.xyw);
