#endif
UNITY_BINDING(0) uniform CGlobals {
	uint g_VertCount;
};
 struct inVertices_type {
	uint[7] value;
};

layout(std430, binding = 1) readonly buffer inVertices {
	inVertices_type inVertices_buf[];
};
