    u_xlat7.y = u_xlat4.x;
    u_xlat7.z = u_xlat5.x;
    u_xlat7.w = u_xlat6.x;
    u_xlat8.x = u_xlat3.y;
    u_xlat8.y = u_xlat4.y;
    u_xlat8.z = u_xlat5.y;
    u_xlat8.w = u_xlat6.y;
    u_xlat6.x = u_xlat3.z;
    u_xlat6.y = u_xlat4.z;
    u_xlat6.z = u_xlat5.z;
